{
  "name": "todosday",
  "private": true,
  "packageManager": "pnpm@12.23.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter @todosday/shared build && pnpm -r --parallel dev",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "test:e2e": "pnpm --filter @todosday/api test:e2e"
  }
}
