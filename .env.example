# ==== PostgreSQL ====
POSTGRES_USER=todosday
POSTGRES_PASSWORD=ubah-password-ini
POSTGRES_DB=todosday

# ==== Backend API ====
# `postgres` di bawah adalah nama service di docker-compose.yml.
DATABASE_URL=postgresql://todosday:ubah-password-ini@postgres:5432/todosday
JWT_SECRET=ganti-dengan-string-acak-minimal-32-karakter

# Origin frontend yang diizinkan akses API (dipisah koma bila lebih dari satu), contoh:
# CORS_ORIGIN=https://todosday.vercel.app,https://todosday.example.com
CORS_ORIGIN=

# ==== Deployment ====
# Username GitHub (huruf kecil) pemilik image di GHCR.
GHCR_OWNER=username-github
# Diisi otomatis oleh CI dengan commit SHA; `latest` untuk pull manual.
IMAGE_TAG=latest
