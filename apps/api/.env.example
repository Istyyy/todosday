# Konfigurasi backend untuk development lokal.
# Salin menjadi .env lalu sesuaikan. Password di DATABASE_URL harus sama
# dengan POSTGRES_PASSWORD di .env root (yang dipakai container postgres).
DATABASE_URL=postgresql://todosday:ubah-password-ini@localhost:5432/todosday
JWT_SECRET=secret-lokal-untuk-development-saja
PORT=3001
CORS_ORIGIN=http://localhost:3000
